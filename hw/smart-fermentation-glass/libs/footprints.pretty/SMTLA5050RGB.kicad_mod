(module "SMTLA5050RGB" (layer F.Cu)
  (descr "Bivar SMTLA5050RGB addressable RGB LED, 4-pad 5050-style package")
  (tags "LED RGB addressable Bivar SMTLA5050RGB")
  (attr smd)
  (fp_text reference D** (at 0 -3.6) (layer F.SilkS)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text user %R (at 0 0) (layer F.Fab)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )
  (fp_text value "SMTLA5050RGB" (at 0 3.6) (layer F.Fab)
    (effects (font (size 1.0 1.0) (thickness 0.15)))
  )

  (fp_line (start -2.7 -2.5) (end 2.7 -2.5) (layer F.Fab) (width 0.1))
  (fp_line (start 2.7 -2.5) (end 2.7 2.5) (layer F.Fab) (width 0.1))
  (fp_line (start 2.7 2.5) (end -2.7 2.5) (layer F.Fab) (width 0.1))
  (fp_line (start -2.7 2.5) (end -2.7 -2.5) (layer F.Fab) (width 0.1))

  (fp_line (start -2.9 -2.7) (end 2.9 -2.7) (layer F.CrtYd) (width 0.05))
  (fp_line (start 2.9 -2.7) (end 2.9 2.7) (layer F.CrtYd) (width 0.05))
  (fp_line (start 2.9 2.7) (end -2.9 2.7) (layer F.CrtYd) (width 0.05))
  (fp_line (start -2.9 2.7) (end -2.9 -2.7) (layer F.CrtYd) (width 0.05))

  (fp_line (start -2.7 -2.5) (end -1.8 -2.5) (layer F.SilkS) (width 0.15))
  (fp_line (start -2.7 -2.5) (end -2.7 -1.6) (layer F.SilkS) (width 0.15))
  (fp_line (start 1.8 -2.5) (end 2.7 -2.5) (layer F.SilkS) (width 0.15))
  (fp_line (start 2.7 -2.5) (end 2.7 -1.6) (layer F.SilkS) (width 0.15))
  (fp_line (start -2.7 1.6) (end -2.7 2.5) (layer F.SilkS) (width 0.15))
  (fp_line (start -2.7 2.5) (end -1.8 2.5) (layer F.SilkS) (width 0.15))
  (fp_line (start 1.8 2.5) (end 2.7 2.5) (layer F.SilkS) (width 0.15))
  (fp_line (start 2.7 1.6) (end 2.7 2.5) (layer F.SilkS) (width 0.15))

  (fp_circle (center -2.3 -2.0) (end -2.1 -2.0) (layer F.SilkS) (width 0.15))

  (pad 1 smd rect (at -1.8 -1.2) (size 1.4 0.9) (layers F.Cu F.Paste F.Mask))
  (pad 2 smd rect (at 1.8 -1.2) (size 1.4 0.9) (layers F.Cu F.Paste F.Mask))
  (pad 3 smd rect (at 1.8 1.2) (size 1.4 0.9) (layers F.Cu F.Paste F.Mask))
  (pad 4 smd rect (at -1.8 1.2) (size 1.4 0.9) (layers F.Cu F.Paste F.Mask))
)
